---
import RootLayout from '../layouts/RootLayout.astro';
import Title from '../components/Title.astro';
import Main from '../components/Main.astro';
import { faGhost, faLeftLong, faHome } from '@fortawesome/free-solid-svg-icons';
import Fa from 'svelte-fa';
---

<script>
  const backButtons = document.querySelectorAll('[data-back-button]');

  for (const button of backButtons) {
    button.addEventListener('click', () => history.back());
  }
</script>

<RootLayout>
  <Main>
    <Title>Page not found</Title>
    <div class="text-center mb-8">
      <Fa icon={faGhost} class="text-5xl inline" />
    </div>
    <p class="text-center mb-8">Maybe you misspelled something?</p>

    <div class="text-fg-muted flex flex-wrap justify-center gap-x-12 gap-y-4">
      <button
        class="hover:text-fg flex cursor-pointer items-center gap-x-2"
        data-back-button
      >
        <Fa icon={faLeftLong} />
        <span>Back</span>
      </button>
      <a
        href="/"
        class="hover:text-fg flex cursor-pointer items-center gap-x-2"
      >
        <Fa icon={faHome} />
        <span>Home</span>
      </a>
    </div>
  </Main>
</RootLayout>
