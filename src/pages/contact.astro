---
import {
  faBluesky,
  faDiscord,
  faGithub,
  faTwitter,
} from '@fortawesome/free-brands-svg-icons';
import Fa from 'svelte-fa';
import Main from '../components/Main.astro';
import Prose from '../components/Prose.astro';
import Title from '../components/Title.astro';
import RootLayout from '../layouts/RootLayout.astro';
import ExternalLink from '../components/ExternalLink.astro';

const links = [
  {
    label: 'Discord',
    to: 'https://discord.com/users/857769260604588052',
    icon: faDiscord,
  },
  {
    label: 'GitHub',
    to: 'https://github.com/Grazen0',
    icon: faGithub,
  },
  {
    label: 'Twitter / X',
    to: 'https://x.com/Grazen0',
    icon: faTwitter,
  },
  {
    label: 'BlueSky',
    to: 'https://bsky.app/profile/grazen0.bsky.social',
    icon: faBluesky,
  },
] as const;
---

<RootLayout>
  <Main>
    <Title>Contact</Title>
    <Prose>
      <p>
        Feel free to reach out to me for whatever. Here are some useful links:
      </p>
      <ul>
        {
          links.map((link) => (
            <li>
              <ExternalLink
                href={link.to}
                class="inline-flex items-center gap-x-2"
              >
                <Fa icon={link.icon} />
                {link.label}
              </ExternalLink>
            </li>
          ))
        }
      </ul>
    </Prose>
  </Main>
</RootLayout>
