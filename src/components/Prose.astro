---
import { type HTMLAttributes } from 'astro/types';
import 'katex/dist/katex.min.css';

type Props = HTMLAttributes<'div'>;

const { class: className, ...props } = Astro.props;
---

<div
  class:list={[
    'prose prose-kanagawa md:prose-lg max-w-none prose-figure:text-center prose-img:mx-auto font-sans prose-pre:border prose-pre:border-border my-16 prose-pre:prose-code:block',
    className,
  ]}
  {...props}
>
  <slot />
</div>

<style>
  @reference '@/styles/global.css';

  .prose {
    blockquote p {
      &::before,
      &::after {
        content: none;
      }
    }

    code:not(pre code) {
      @apply bg-bg-alt;
      &::before,
      &::after {
        content: none;
      }
    }

    h1,
    h2,
    h3,
    h4 {
      a {
        text-decoration: none;
        color: var(--color-fg-muted);

        &:hover {
          filter: brightness(1.25);
        }

        .icon-link::before {
          @apply ml-3;
          content: '#';
        }
      }
    }
  }
</style>
